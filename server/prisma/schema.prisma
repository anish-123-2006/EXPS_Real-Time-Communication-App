generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  rooms Room[]
}

model Room {
  id        String   @id @default(uuid())
  title     String?
  hostId    String
  createdAt DateTime @default(now())

  host User @relation(fields: [hostId], references: [id])
}
